<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.GpxNavPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gpx_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gpx_yellow</item>
        <item name="colorOnSecondary">@color/gpx_blue_dark</item>
        <item name="colorSurface">@color/gpx_blue_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/gpx_blue_surface</item>
        <item name="colorOnSurfaceVariant">@color/gpx_text_secondary</item>
        <item name="android:colorAccent">@color/gpx_yellow</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gpx_text_secondary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.GpxNavPro.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.GpxNavPro.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/gpx_yellow</item>
        <item name="colorOnPrimary">@color/gpx_blue_dark</item>
        <item name="colorSurface">@color/gpx_blue_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/gpx_blue_surface</item>
        <item name="colorOnSurfaceVariant">@color/gpx_text_secondary</item>
        <item name="android:colorAccent">@color/gpx_yellow</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gpx_text_secondary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_blue</item>
    </style>

    <style name="GpxNavProCircleShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.GpxNavPro" parent="Base.Theme.GpxNavPro" />
</resources>
