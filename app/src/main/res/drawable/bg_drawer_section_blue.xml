<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FF9F1C">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="2dp"
                        android:topRightRadius="14dp"
                        android:bottomRightRadius="2dp"
                        android:bottomLeftRadius="14dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#33FF9F1C"
                        android:endColor="#0AFF9F1C" />
                </shape>
            </item>
            <item android:gravity="start" android:width="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#38BDF8" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
